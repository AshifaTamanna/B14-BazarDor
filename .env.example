# Optional locally; when set, Better Auth uses MongoDB instead of SQLite.
# Required on Vercel so accounts persist between deployments and instances.
MONGODB_URI=
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Canonical app origin only; do not include /api/auth.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google OAuth Web client callback:
# http://localhost:3000/api/auth/callback/google
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_SECRET=
# GitHub OAuth App callback:
# http://localhost:3000/api/auth/callback/github
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_SECRET=
